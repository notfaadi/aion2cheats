---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, softwareApplicationSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from './Breadcrumbs.astro';
import { Button } from '@/components/starwind/button';
import Icon from './icons/Icon.astro';
import { PRODUCT_BASE } from '../config/site';
import { PRIMARY_CHECKOUT_PATH } from '../config/checkout';

export interface SeoKeywordSection {
  h2: string;
  paragraphs: string[];
}

interface Props {
  path: string;
  intro: string;
  sections: SeoKeywordSection[];
  breadcrumbLabel: string;
}

const { path, intro, sections, breadcrumbLabel } = Astro.props;
const seo = resolvePageSeo(path);
const h1 = seo.h1 ?? seo.title.split('|')[0]?.trim() ?? seo.title;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: breadcrumbLabel, path },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    webPageSchema({ name: h1, description: seo.description, url: path }),
    softwareApplicationSchema({
      name: 'Aion 2 Cheats & Hacks',
      description: seo.description,
      url: path,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 text-3xl font-bold uppercase leading-tight md:text-4xl">{h1}</h1>
      <p class="mt-4 text-lg text-muted-foreground">
        {h1}. {intro}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button as="a" href={PRODUCT_BASE} variant="primary">
          View products
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={PRIMARY_CHECKOUT_PATH} variant="outline">
          Buy now
          <Icon name="arrowRight" size={17} />
        </Button>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="mx-auto max-w-3xl space-y-10 px-5">
      {
        sections.map((block) => (
          <article>
            <h2 class="text-xl font-semibold uppercase tracking-wide text-foreground">{block.h2}</h2>
            {block.paragraphs.map((p) => (
              <p class="mt-3 text-muted-foreground leading-relaxed">{p}</p>
            ))}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
