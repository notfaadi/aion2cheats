---
import type { AionFeatureModule } from '../../data/aionFeatureModules';
import Icon from '../icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  module: AionFeatureModule;
  maxFeatures?: number;
  class?: string;
}

const { module, maxFeatures = 4, class: className } = Astro.props;

const displayFeatures = module.features.slice(0, maxFeatures);
const more = Math.max(0, module.features.length - displayFeatures.length);
---

<Card class:list={['flex h-full flex-col', className]}>
  <CardHeader class="space-y-2.5">
    <CardTitle class="text-lg normal-case leading-snug">{module.title}</CardTitle>
    <div class="catalog-card__badges flex flex-wrap items-center gap-1.5">
      <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
        <Icon name={module.icon} size={12} class="shrink-0" />
        {module.label}
      </Badge>
      {
        module.badge && (
          <Badge tone="success" appearance="soft" size="sm" class="catalog-card__badge gap-1">
            <Icon name="circleCheck" size={12} class="shrink-0" />
            {module.badge}
          </Badge>
        )
      }
    </div>
  </CardHeader>
  <CardContent class="flex-1">
    <ul class="space-y-2 text-sm text-muted-foreground">
      {
        displayFeatures.map((feature) => (
          <li class="flex items-start gap-2">
            <Icon name="check" size={14} class="mt-0.5 shrink-0" />
            <span>{feature}</span>
          </li>
        ))
      }
      {more > 0 && <li class="text-xs text-muted-foreground">+{more} more features</li>}
    </ul>
  </CardContent>
</Card>
